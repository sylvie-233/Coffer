# 复制为 scripts/.env 后按需修改；docker compose 会自动读取同目录 .env
#
# 生产部署前必须修改：
#   - MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD
#   - JWT_SECRET（至少 32 位随机字符串）
#   - S3_ACCESS_KEY / S3_SECRET_KEY
# 并做好数据卷备份（MySQL 与 RustFS 缺一不可，两者共同构成完整保险库）。

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=coffer
MYSQL_USER=coffer
MYSQL_PASSWORD=123456
MYSQL_PORT=3306
DB_CONNECTION_LIMIT=10

# ---------- API ----------
API_PORT=3000
JWT_SECRET=coffer-dev-secret-change-me-please
JWT_EXPIRES_IN=7200
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# ---------- RustFS（S3 兼容对象存储） ----------
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_BUCKET=coffer
S3_PORT=9000
# 管理控制台端口
S3_CONSOLE_PORT=9001

# ---------- Web ----------
WEB_PORT=8080
