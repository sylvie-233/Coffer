{
  "name": "@coffer/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Coffer 共享数据库层（Drizzle schema + MySQL 连接）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@coffer/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
