{
  "name": "@coffer/vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Coffer 保险库 React 页面与功能组件（Web / Electron 共用）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@coffer/crypto": "workspace:*",
    "@coffer/types": "workspace:*",
    "@coffer/ui": "workspace:*",
    "@coffer/utils": "workspace:*",
    "@coffer/vault-core": "workspace:*",
    "lucide-react": "^0.469.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@coffer/tsconfig": "workspace:*",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
