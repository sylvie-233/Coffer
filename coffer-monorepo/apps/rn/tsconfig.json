{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "index.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "plugins/**/*.js"
  ],
  "exclude": [
    "android",
    "ios",
    "node_modules"
  ]
}
