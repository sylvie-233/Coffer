{
  "name": "@coffer/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Coffer 零知识凭证管理器 API（Hono + MySQL + RustFS）",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --dts --clean --target node20",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@coffer/crypto": "workspace:*",
    "@coffer/db": "workspace:*",
    "@coffer/types": "workspace:*",
    "@coffer/utils": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@scalar/hono-api-reference": "^0.12.18",
    "dotenv": "^18.0.9",
    "hono": "^4.6.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@coffer/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
