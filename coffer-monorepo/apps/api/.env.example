# 复制为同目录下的 .env 后按需修改
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MySQL（与 scripts/docker-compose.yml 默认值一致）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=coffer
DB_PASSWORD=123456
DB_NAME=coffer
DB_CONNECTION_LIMIT=10

# JWT：生产环境必须替换为随机长字符串（至少 16 位，建议 32 位以上）
JWT_SECRET=coffer-dev-secret-change-me-please
JWT_EXPIRES_IN=7200

# 允许跨域的 Web 来源（多个用英文逗号分隔）
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# RustFS（S3 兼容对象存储）
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=coffer
S3_FORCE_PATH_STYLE=true
